{
  "network": {
    "id": "purple_dot",
    "display_name": "Purple Dots",
    "description": "Discovery and services network for People with Disabilities.",
    "instances": [
      {
        "instance_name": "Purple Dot Seeker Local",
        "instance_url": "http://localhost:2742",
        "custom_item_schema_urls": {},
        "domain_id": "seeker"
      },
      {
        "instance_name": "Purple Dot Service Provider Local",
        "instance_url": "http://localhost:2742",
        "custom_item_schema_urls": {},
        "domain_id": "provider"
      }
    ]
  },
  "domains": [
    {
      "sheet": "Seeker_Profile_Schema",
      "id": "seeker",
      "fields": [
        {
          "row": 2,
          "key": "beneficiary_name",
          "title": "Name"
        },
        {
          "row": 3,
          "key": "mobile_number",
          "title": "Mobile"
        },
        {
          "row": 4,
          "key": "email",
          "title": "Email"
        },
        {
          "row": 5,
          "key": "age",
          "title": "Age",
          "set": {
            "minimum": 1,
            "maximum": 100
          }
        },
        {
          "row": 6,
          "key": "gender",
          "title": "Gender"
        },
        {
          "row": 7,
          "key": "disability_type",
          "title": "Disability",
          "set": {
            "vector_weight": 2,
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "Acid Attack Victim",
                "Autism Spectrum Disorder",
                "Blindness",
                "Cerebral Palsy",
                "Dwarfism",
                "Hearing Impairment",
                "Hemophilia",
                "Intellectual Disability",
                "Leprosy Cured",
                "Locomotor Disability",
                "Low Vision",
                "Mental Illness",
                "Multiple Sclerosis",
                "Muscular Dystrophy",
                "Parkinson's Disease",
                "Sickle Cell Disease",
                "Specific Learning Disabilities",
                "Speech and Language Disability",
                "Thalassemia",
                "Chronic Neurological Conditions",
                "Deaf",
                "Multiple Disabilities including deaf-blindness",
                "Mental Retardation"
              ]
            }
          }
        },
        {
          "row": 8,
          "key": "disability_percentage",
          "title": "Disability %",
          "set": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "unset": [
            "vectorize"
          ]
        },
        {
          "row": 9,
          "key": "looking_for",
          "title": "Looking For",
          "description": "What are you looking for?",
          "set": {
            "minItems": 1
          }
        },
        {
          "row": 10,
          "key": "looking_for_details",
          "title": "Details",
          "description": "Explain your needs in detail",
          "set": {
            "minLength": 1,
            "vector_weight": 2
          }
        },
        {
          "row": 11,
          "key": "address",
          "title": "Address",
          "description": "Street, City or Village, District, where you can receive the service or support",
          "set": {
            "minLength": 1,
            "location": "primary"
          }
        },
        {
          "row": 12,
          "key": "documents_available",
          "title": "Documents",
          "description": "Which documents do you have?",
          "set": {
            "minItems": 1
          },
          "unset": [
            "vectorize"
          ]
        },
        {
          "row": 13,
          "key": "highest_qualification",
          "title": "Qualification",
          "description": "Highest qualification"
        }
      ],
      "item_type": "profile_1.0",
      "schema_title": "PWD Seeker Profile 1.0",
      "order": [
        "beneficiary_name",
        "mobile_number",
        "email",
        "age",
        "gender",
        "disability_type",
        "disability_percentage",
        "looking_for",
        "looking_for_details",
        "address",
        "documents_available",
        "highest_qualification"
      ],
      "required": [
        "beneficiary_name",
        "mobile_number"
      ],
      "all_of": [],
      "layout": {
        "sections": [
          {
            "title": "Personal Details",
            "fields": [
              "beneficiary_name",
              "age",
              "gender",
              "mobile_number",
              "email"
            ]
          },
          {
            "title": "Disability Profile",
            "fields": [
              "disability_type",
              "disability_percentage",
              "looking_for",
              "looking_for_details"
            ]
          },
          {
            "title": "Location",
            "fields": [
              "address"
            ]
          },
          {
            "title": "Documents & Education",
            "fields": [
              "documents_available",
              "highest_qualification"
            ]
          }
        ],
        "twoColumn": [
          "age",
          "gender",
          "mobile_number",
          "email"
        ]
      },
      "card": {
        "title_field": "beneficiary_name",
        "avatar_from": "beneficiary_name",
        "default_fields": [
          "disability_type",
          "looking_for",
          "highest_qualification"
        ]
      },
      "contact_fields": {
        "name": "beneficiary_name",
        "phone": "mobile_number",
        "email": "email"
      },
      "settings": {
        "description": "Persons with disabilities seeking services, devices, training, or other support.",
        "minimum_cache_ttl_seconds": 300,
        "status_rules": [
          {
            "status": "new",
            "label": "New",
            "description": "Joined within the last 7 days",
            "when": {
              "item_age_days": {
                "lte": 7
              }
            }
          },
          {
            "status": "active",
            "label": "Active",
            "description": "Connected with a provider in the last 30 days",
            "when": {
              "days_since_last": {
                "buckets": [
                  "create",
                  "accept"
                ],
                "lte": 30
              }
            }
          },
          {
            "status": "at_risk",
            "label": "At Risk",
            "description": "No activity for 30–90 days",
            "when": {
              "days_since_last": {
                "buckets": [
                  "create",
                  "accept",
                  "reject"
                ],
                "between": [
                  31,
                  90
                ]
              }
            }
          },
          {
            "status": "inactive",
            "label": "Inactive",
            "description": "No activity 90+ days",
            "when": "default"
          }
        ],
        "profile_completion_prompt": {
          "heading": "Complete your profile to find the right support",
          "body": "Providers can find and connect with you only once your profile is live. Fill in the details below to get matched with the services and support you need."
        },
        "go_live_required": [
          "schema_required",
          "consent_required"
        ],
        "my_items_label": "My Actions",
        "guardian_consent_required": true,
        "dashboard_tiles": {
          "profile": [
            {
              "field": "total_items",
              "label": "Profiles Registered"
            },
            {
              "field": "complete_profiles",
              "label": "Profiles Complete"
            },
            {
              "field": "has_applications",
              "label": "Made Connections"
            }
          ],
          "user": [
            {
              "field": "total_users",
              "label": "Total Seekers"
            },
            {
              "field": "avg_items_per_user",
              "label": "Avg Profiles per User"
            },
            {
              "field": "avg_actions_per_user",
              "label": "Avg Actions per User"
            }
          ]
        }
      },
      "domain_key_order": [
        "description",
        "minimum_cache_ttl_seconds",
        "status_rules",
        "item_schemas",
        "profile_completion_prompt",
        "id",
        "go_live_required",
        "my_items_label",
        "guardian_consent_required",
        "card",
        "contact_fields",
        "dashboard_tiles"
      ]
    },
    {
      "sheet": "ServiceProvider_MyServices_Sche",
      "id": "provider",
      "fields": [
        {
          "row": 2,
          "key": "contact_name",
          "title": "Contact Name"
        },
        {
          "row": 3,
          "key": "contact_phone",
          "title": "Phone"
        },
        {
          "row": 4,
          "key": "contact_email",
          "title": "Email"
        },
        {
          "row": 5,
          "key": "provider_category",
          "title": "Category",
          "description": "Select the category that applies to you",
          "unset": [
            "minLength"
          ]
        },
        {
          "row": 6,
          "key": "crr_number",
          "title": "CRR Number",
          "set": {
            "type": "string",
            "pattern": "^$|^[0-9]+$",
            "x-error-message": "Enter your CRR number using digits only.",
            "x-show-if": {
              "provider_category": [
                "RCI"
              ]
            }
          }
        },
        {
          "row": 7,
          "key": "professional_type",
          "title": "Type of Professional",
          "set": {
            "x-show-if": {
              "provider_category": [
                "RCI"
              ]
            }
          }
        },
        {
          "row": 8,
          "key": "organisation_name",
          "title": "Organisation",
          "description": "Name of your organisation (or your name if individual)"
        },
        {
          "row": 9,
          "key": "website",
          "title": "Website",
          "description": "Not required at signup; can be added or edited later"
        },
        {
          "row": 10,
          "key": "disabilities_served",
          "title": "Disabilities Served",
          "description": "What type of seekers are you looking for?",
          "set": {
            "vector_weight": 2,
            "items": {
              "type": "string",
              "enum": [
                "Acid Attack Victim",
                "Autism Spectrum Disorder",
                "Blindness",
                "Cerebral Palsy",
                "Dwarfism",
                "Hearing Impairment",
                "Hemophilia",
                "Intellectual Disability",
                "Leprosy Cured",
                "Locomotor Disability",
                "Low Vision",
                "Mental Illness",
                "Multiple Sclerosis",
                "Muscular Dystrophy",
                "Parkinson's Disease",
                "Sickle Cell Disease",
                "Specific Learning Disabilities",
                "Speech and Language Disability",
                "Thalassemia",
                "Chronic Neurological Conditions",
                "Deaf",
                "Multiple Disabilities including deaf-blindness",
                "Mental Retardation"
              ]
            }
          }
        },
        {
          "row": 11,
          "key": "services_offered",
          "title": "Services Offered",
          "description": "What services or support do you provide?"
        },
        {
          "row": 12,
          "key": "service_cities",
          "title": "Service Cities",
          "description": "Cities where seekers can access your services",
          "set": {
            "location": "primary",
            "maxItems": 5
          }
        },
        {
          "row": 13,
          "key": "official_address",
          "title": "Organisation Address",
          "description": "Your organisation's office or headquarters address",
          "set": {
            "location": "secondary"
          },
          "unset": [
            "private"
          ]
        },
        {
          "row": 14,
          "key": "service_details",
          "title": "Service Details",
          "description": "Share more about the service, opportunity, or support provided",
          "set": {
            "vector_weight": 2
          }
        },
        {
          "row": 15,
          "key": "catalog_url",
          "property": {
            "type": "string",
            "title": "Catalog URL",
            "description": "URL to a catalog or service list you provide",
            "format": "uri"
          }
        }
      ],
      "item_type": "profile_1.0",
      "schema_title": "PWD Service Provider Profile 1.0",
      "display_name_field": "organisation_name",
      "order": [
        "contact_name",
        "contact_phone",
        "contact_email",
        "provider_category",
        "crr_number",
        "professional_type",
        "organisation_name",
        "website",
        "disabilities_served",
        "services_offered",
        "service_cities",
        "official_address",
        "service_details",
        "catalog_url"
      ],
      "required": [
        "contact_name",
        "contact_phone",
        "provider_category",
        "organisation_name",
        "disabilities_served",
        "services_offered",
        "service_cities",
        "official_address",
        "service_details"
      ],
      "all_of": [
        {
          "if": {
            "properties": {
              "provider_category": {
                "const": "RCI"
              }
            },
            "required": [
              "provider_category"
            ]
          },
          "then": {
            "required": [
              "crr_number",
              "professional_type"
            ],
            "properties": {
              "crr_number": {
                "minLength": 1
              }
            }
          }
        }
      ],
      "layout": {
        "sections": [
          {
            "title": "Contact Details",
            "fields": [
              "contact_name",
              "contact_phone",
              "contact_email"
            ]
          },
          {
            "title": "Organisation",
            "fields": [
              "provider_category",
              "crr_number",
              "professional_type",
              "organisation_name",
              "website",
              "official_address"
            ]
          },
          {
            "title": "Services & Coverage",
            "fields": [
              "disabilities_served",
              "services_offered",
              "service_cities"
            ]
          },
          {
            "title": "More Details",
            "fields": [
              "service_details",
              "catalog_url"
            ]
          }
        ],
        "twoColumn": [
          "contact_phone",
          "contact_email"
        ]
      },
      "card": {
        "title_field": "organisation_name",
        "avatar_from": "organisation_name",
        "default_fields": [
          "provider_category",
          "professional_type",
          "services_offered",
          "service_cities",
          "disabilities_served"
        ],
        "extra_fields": [
          "contact_name",
          "contact_phone",
          "contact_email",
          "organisation_name",
          "website",
          "official_address",
          "service_details",
          "catalog_url"
        ]
      },
      "contact_fields": {
        "name": "contact_name",
        "phone": "contact_phone",
        "email": "contact_email"
      },
      "settings": {
        "description": "Organisations and individuals providing services, devices, training, or other support for persons with disabilities.",
        "minimum_cache_ttl_seconds": 300,
        "status_rules": [
          {
            "status": "new",
            "label": "New",
            "description": "Service posted within the last 7 days",
            "when": {
              "item_age_days": {
                "lte": 7
              }
            }
          },
          {
            "status": "active",
            "label": "Active",
            "description": "Accepted or rejected a request in the last 30 days",
            "when": {
              "all": [
                {
                  "count": {
                    "buckets": [
                      "create"
                    ],
                    "gt": 0
                  }
                },
                {
                  "days_since_last": {
                    "buckets": [
                      "accept",
                      "reject"
                    ],
                    "lte": 30
                  }
                }
              ]
            }
          },
          {
            "status": "at_risk",
            "label": "At Risk",
            "description": "No responses for 30–90 days",
            "when": {
              "all": [
                {
                  "count": {
                    "buckets": [
                      "create"
                    ],
                    "gt": 0
                  }
                },
                {
                  "days_since_last": {
                    "buckets": [
                      "accept",
                      "reject"
                    ],
                    "between": [
                      31,
                      90
                    ]
                  }
                }
              ]
            }
          },
          {
            "status": "inactive",
            "label": "Inactive",
            "description": "No activity for 90+ days",
            "when": "default"
          }
        ],
        "profile_completion_prompt": {
          "heading": "Complete your profile to reach people who need support",
          "body": "People looking for services can discover and connect with you only once your profile is live. Add your details below to start helping."
        },
        "label": "Service Provider",
        "plural_label": "Service Providers",
        "go_live_required": [
          "schema_required",
          "consent_required"
        ],
        "my_items_label": "My Services",
        "dashboard_tiles": {
          "profile": [
            {
              "field": "total_items",
              "label": "Profiles Registered"
            },
            {
              "field": "complete_profiles",
              "label": "Profiles Complete"
            },
            {
              "field": "has_applications",
              "label": "Received Connections"
            }
          ],
          "user": [
            {
              "field": "total_users",
              "label": "Total Service Providers"
            },
            {
              "field": "avg_items_per_user",
              "label": "Avg Profiles per User"
            },
            {
              "field": "avg_actions_per_user",
              "label": "Avg Actions per User"
            }
          ]
        }
      },
      "domain_key_order": [
        "description",
        "minimum_cache_ttl_seconds",
        "status_rules",
        "item_schemas",
        "profile_completion_prompt",
        "id",
        "label",
        "plural_label",
        "go_live_required",
        "my_items_label",
        "card",
        "contact_fields",
        "dashboard_tiles"
      ]
    }
  ],
  "actions": {
    "connect": {
      "description": "Lets a seeker and a provider request a connection with each other. Either party can initiate; the receiver can accept, reject, or the initiator can cancel before the receiver responds.",
      "interactions": [
        {
          "from_network": "purple_dot",
          "from_domain": "seeker",
          "to_network": "purple_dot",
          "to_domain": "provider",
          "column_fields": {
            "from": [
              "disability_type",
              "looking_for",
              "highest_qualification"
            ],
            "to": [
              "provider_category",
              "organisation_name",
              "services_offered",
              "service_cities"
            ]
          },
          "requirement_schema": {
            "type": "object",
            "properties": {}
          },
          "event_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Seeker To Provider Connect Event",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "remark"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "created",
                  "accepted",
                  "completed",
                  "rejected",
                  "cancelled"
                ]
              },
              "remark": {
                "type": "string"
              }
            }
          },
          "metric_categories": {
            "create": [
              "created"
            ],
            "accept": [
              "accepted"
            ],
            "reject": [
              "rejected"
            ],
            "cancel": [
              "cancelled"
            ]
          },
          "reveals_pii_on_status": [
            "accepted",
            "completed"
          ],
          "export": {
            "requester_domains": [
              "provider"
            ]
          }
        },
        {
          "from_network": "purple_dot",
          "from_domain": "provider",
          "to_network": "purple_dot",
          "to_domain": "seeker",
          "column_fields": {
            "from": [
              "provider_category",
              "organisation_name",
              "services_offered",
              "service_cities"
            ],
            "to": [
              "disability_type",
              "looking_for",
              "highest_qualification"
            ]
          },
          "requirement_schema": {
            "type": "object",
            "properties": {}
          },
          "event_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Provider To Seeker Connect Event",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "remark"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "created",
                  "accepted",
                  "completed",
                  "rejected",
                  "cancelled"
                ]
              },
              "remark": {
                "type": "string"
              }
            }
          },
          "metric_categories": {
            "create": [
              "created"
            ],
            "accept": [
              "accepted"
            ],
            "reject": [
              "rejected"
            ],
            "cancel": [
              "cancelled"
            ]
          },
          "reveals_pii_on_status": [
            "accepted",
            "completed"
          ],
          "export": {
            "requester_domains": [
              "provider"
            ]
          }
        }
      ]
    }
  },
  "dashboard_buckets": {
    "by_status": {
      "new": "New",
      "active": "Active",
      "at_risk": "At Risk",
      "inactive": "Inactive"
    },
    "by_initiated_action_status": {
      "create": "Requested",
      "accept": "Accepted",
      "reject": "Declined",
      "cancel": "Cancelled"
    },
    "by_received_action_status": {
      "create": "Requests",
      "accept": "Connected",
      "reject": "Declined",
      "cancel": "Cancelled"
    }
  },
  "forms_full": {
    "org-registration.v1.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.bluedots.org/aggregator/org-registration.v1.json",
      "title": "Organisation Registration",
      "description": "Signup payload for a new parent organisation (spec §6.1). Captures the org display name, optional state, the org owner's contact identity, and consent. The URL slug is generated by the server at submit and is not supplied by the client. Coordinators register separately and select an approved org.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "aggregator_type",
        "organisation_type",
        "owner",
        "consent"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "title": "Organisation Name",
          "minLength": 2,
          "maxLength": 200,
          "examples": [
            "ABC Limited",
            "XYZ Foundation"
          ]
        },
        "website": {
          "type": "string",
          "title": "Website",
          "format": "uri",
          "maxLength": 2048,
          "description": "Not required at signup; can be added or edited later.",
          "examples": [
            "https://abclimited.org"
          ],
          "x-updatable": true
        },
        "aggregator_type": {
          "type": "array",
          "title": "Aggregator Type",
          "description": "Which participants this organisation represents. Captured as information only — it does not restrict what its coordinators can do.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "seeker",
              "provider"
            ]
          },
          "examples": [
            [
              "seeker"
            ],
            [
              "provider"
            ],
            [
              "seeker",
              "provider"
            ]
          ]
        },
        "organisation_type": {
          "type": "string",
          "title": "Organisation Type",
          "description": "The broad category that describes your organisation.",
          "enum": [
            "ngo",
            "government_entity",
            "private_company",
            "community_group",
            "other"
          ]
        },
        "address": {
          "type": "object",
          "title": "Address",
          "description": "Street onwards for the organisation.",
          "additionalProperties": false,
          "properties": {
            "streetAddress": {
              "type": "string",
              "title": "Street",
              "maxLength": 300
            },
            "addressLocality": {
              "type": "string",
              "title": "City",
              "maxLength": 200
            },
            "addressDistrict": {
              "type": "string",
              "title": "District",
              "maxLength": 200
            },
            "addressRegion": {
              "type": "string",
              "title": "State",
              "maxLength": 200
            },
            "postalCode": {
              "type": "string",
              "title": "PIN code",
              "maxLength": 20
            },
            "addressCountry": {
              "type": "string",
