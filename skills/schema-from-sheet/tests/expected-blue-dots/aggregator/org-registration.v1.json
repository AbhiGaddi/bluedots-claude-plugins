{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bluedots.org/aggregator/org-registration.v1.json",
  "title": "Organisation Registration",
  "description": "Signup payload for a new parent organisation (spec §6.1). Captures the org display name, optional state, the org owner's contact identity, and consent. The URL slug is generated by the server at submit and is not supplied by the client. Coordinators register separately and select an approved org.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "display_name",
    "aggregator_type",
    "organisation_type",
    "management_type",
    "owner",
    "consent"
  ],
  "properties": {
    "display_name": {
      "type": "string",
      "title": "Organisation Name",
      "minLength": 2,
      "maxLength": 200,
      "examples": [
        "ABC Limited",
        "XYZ Foundation"
      ]
    },
    "website": {
      "type": "string",
      "title": "Website",
      "format": "uri",
      "maxLength": 2048,
      "description": "Not required at signup; can be added or edited later.",
      "examples": [
        "https://abclimited.org"
      ],
      "x-updatable": true
    },
    "aggregator_type": {
      "type": "array",
      "title": "Aggregator Type",
      "description": "Which participants this organisation represents. Captured as information only — it does not restrict what its coordinators can do.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "seeker",
          "provider",
          "service_provider"
        ]
      },
      "examples": [
        [
          "seeker"
        ],
        [
          "provider"
        ],
        [
          "service_provider"
        ]
      ]
    },
    "organisation_type": {
      "type": "string",
      "title": "Organisation Type",
      "description": "The broad category that describes your organisation.",
      "enum": [
        "educational",
        "non_educational"
      ]
    },
    "organisation_sub_type_educational": {
      "type": "string",
      "title": "Organisation Sub-Type",
      "description": "Select the type that best applies.",
      "x-show-if": {
        "organisation_type": [
          "educational"
        ]
      },
      "enum": [
        "school",
        "pu_college",
        "college",
        "iti",
        "other_vocational_training",
        "polytechnic",
        "diploma",
        "other"
      ]
    },
    "organisation_sub_type_non_educational": {
      "type": "string",
      "title": "Organisation Sub-Type",
      "description": "Select the type that best applies.",
      "x-show-if": {
        "organisation_type": [
          "non_educational"
        ]
      },
      "enum": [
        "employment_exchange",
        "placement_agency",
        "community_group",
        "individual_trainer_counsellor",
        "msme_association",
        "industries_and_commerce_department",
        "other"
      ]
    },
    "management_type": {
      "type": "string",
      "title": "Management Type",
      "description": "Whether the organisation is privately run, government-operated, or an NGO.",
      "enum": [
        "private",
        "government",
        "ngo",
        "other"
      ]
    },
    "address": {
      "type": "object",
      "title": "Address",
      "description": "Street onwards for the organisation.",
      "additionalProperties": false,
      "properties": {
        "streetAddress": {
          "type": "string",
          "title": "Street",
          "maxLength": 300
        },
        "addressLocality": {
          "type": "string",
          "title": "City",
          "maxLength": 200
        },
        "addressDistrict": {
          "type": "string",
          "title": "District",
          "maxLength": 200
        },
        "addressRegion": {
          "type": "string",
          "title": "State",
          "maxLength": 200
        },
        "postalCode": {
          "type": "string",
          "title": "PIN code",
          "maxLength": 20
        },
        "addressCountry": {
          "type": "string",
          "title": "Country",
          "maxLength": 100
        }
      }
    },
    "owner": {
      "type": "object",
      "title": "Organisation Owner",
      "additionalProperties": false,
      "required": [
        "name",
        "phone",
        "email"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Owner Name",
          "minLength": 2,
          "maxLength": 200,
          "examples": [
            "Rajesh Kumar"
          ]
        },
        "phone": {
          "type": "string",
          "title": "Phone",
          "pattern": "^(\\+?\\d{10,15}|\\d{10})$",
          "examples": [
            "+919876543210",
            "9876543210"
          ]
        },
        "email": {
          "type": "string",
          "title": "Email",
          "format": "email",
          "maxLength": 320,
          "examples": [
            "owner@abclimited.org"
          ]
        }
      }
    },
    "consent": {
      "type": "object",
      "title": "Terms & Privacy Consent",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "boolean",
          "title": "I have read and accept the terms and privacy policy"
        },
        "given_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_till": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
